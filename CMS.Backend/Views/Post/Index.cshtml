@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold mb-1" style="color: #1e293b;">Danh sách bài viết</h3>
        <p class="text-muted small mb-0">Xem và quản lý tất cả các bài viết, lộ trình học tập & tin tức công nghệ</p>
    </div>
    <button class="btn-clean btn-sm">
        <i class="bi bi-file-earmark-plus"></i> Tạo bài viết mới
    </button>
</div>

<div class="card-grid">
    @foreach (var item in Model)
    {
        <div class="flat-item-card">
            <!-- Thumbnail -->
            <img src="@item.ImageUrl" class="flat-item-card-img" alt="@item.Title" onerror="this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&auto=format&fit=crop'">
            
            <!-- Content Body -->
            <div class="flat-item-card-body">
                <div class="mb-2">
                    <span class="badge-clean badge-clean-primary" style="font-size: 0.7rem;">@item.Category?.Name</span>
                </div>
                <h5 class="flat-item-card-title text-truncate">@item.Title</h5>
                <p class="flat-item-card-desc">@item.Content</p>
                
                <div class="flat-item-card-footer">
                    <span class="small text-muted"><i class="bi bi-calendar-event me-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")</span>
                    <a href="/Post/Details/@item.Id" class="btn-clean-outline btn-sm py-1 px-2" style="font-size: 0.775rem;">
                        Chi tiết <i class="bi bi-arrow-right small"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
