@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.Id;
}

<div class="flat-card" style="max-width: 800px; margin: 0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1" style="color: #1e293b;"><i class="bi bi-receipt text-primary me-2"></i>Chi Tiết Đơn Hàng #@Model.Id</h4>
            <p class="text-muted small mb-0">Xem danh sách sản phẩm đặt mua, tổng giá trị hóa đơn và thông tin liên hệ giao hàng.</p>
        </div>
        <a asp-action="Index" class="btn-clean-outline btn-sm text-decoration-none px-3">
            Quay lại danh sách
        </a>
    </div>
    <hr style="border-color: var(--border-light);" />

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h6 class="fw-bold text-slate">Thông tin khách hàng:</h6>
            <p class="mb-1"><strong>Họ tên:</strong> @(Model.Customer?.FullName ?? "Khách vãng lai")</p>
            <p class="mb-1"><strong>Email:</strong> @(Model.Customer?.Email ?? "Không có")</p>
            <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.Customer?.Phone ?? "Không có")</p>
            <p class="mb-1"><strong>Địa chỉ:</strong> @(Model.Customer?.Address ?? "Không có")</p>
        </div>
        <div class="col-md-6">
            <h6 class="fw-bold text-slate">Thông tin đơn đặt:</h6>
            <p class="mb-1"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="mb-1"><strong>Trạng thái:</strong> 
                @if (Model.Status == 0) { <span class="badge bg-secondary">Đã tiếp nhận</span> }
                else if (Model.Status == 1) { <span class="badge bg-warning text-dark">Đang đóng gói</span> }
                else if (Model.Status == 2) { <span class="badge bg-primary">Đang vận chuyển</span> }
                else if (Model.Status == 3) { <span class="badge bg-success">Đã hoàn thành</span> }
                else { <span class="badge bg-danger">Đã hủy</span> }
            </p>
            <p class="mb-1"><strong>Ghi chú:</strong> @(Model.Notes ?? "Không có ghi chú")</p>
        </div>
    </div>

    <h5 class="fw-bold text-slate mb-3"><i class="bi bi-box-seam me-2 text-primary"></i>Danh sách mặt hàng đặt mua</h5>
    <div class="clean-table-container mb-4">
        <table class="clean-table">
            <thead>
                <tr>
                    <th style="width: 80px; text-align: center;">Ảnh</th>
                    <th>Sản phẩm</th>
                    <th style="width: 120px; text-align: right;">Đơn giá</th>
                    <th style="width: 80px; text-align: center;">SL</th>
                    <th style="width: 150px; text-align: right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td style="text-align: center; vertical-align: middle;">
                            @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                            {
                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 50px; height: 50px; object-fit: contain; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff;" onerror="this.src='https://images.unsplash.com/photo-1588449668338-d1345b11a4f1?w=800&auto=format&fit=crop'">
                            }
                            else
                            {
                                <div style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0; color: #94a3b8; font-size: 0.8rem; margin: 0 auto;">
                                    <i class="bi bi-box-seam"></i>
                                </div>
                            }
                        </td>
                        <td style="vertical-align: middle;">
                            <strong>@item.Product?.Name</strong>
                        </td>
                        <td style="text-align: right; vertical-align: middle;">
                            @item.UnitPrice.ToString("N0") đ
                        </td>
                        <td style="text-align: center; vertical-align: middle;">@item.Quantity</td>
                        <td style="text-align: right; font-weight: 700; color: #ef4444; vertical-align: middle;">
                            @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                        </td>
                    </tr>
                }
                <tr style="border-top: 2px solid #e2e8f0; background: #fafafa;">
                    <td colspan="4" class="text-end fw-bold">Tổng thanh toán:</td>
                    <td style="text-align: right; font-weight: 800; color: #ef4444; font-size: 1.15rem;">
                        @(Model.OrderDetails.Sum(d => d.UnitPrice * d.Quantity).ToString("N0")) đ
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-clean btn-sm px-4 text-decoration-none">
            <i class="bi bi-pencil-square"></i> Cập nhật trạng thái
        </a>
    </div>
</div>
