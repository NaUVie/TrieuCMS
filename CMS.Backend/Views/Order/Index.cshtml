@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="flat-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1e293b;">Danh sách đơn hàng</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái giao hàng, quản lý hóa đơn mua sắm và xác nhận đơn của khách hàng</p>
        </div>
        <button class="btn-clean btn-sm">
            <i class="bi bi-file-earmark-plus"></i> Tạo đơn hàng mới
        </button>
    </div>

    <div class="clean-table-container">
        <table class="clean-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày đặt hàng</th>
                    <th>Khách hàng</th>
                    <th>Trạng thái giao nhận</th>
                    <th>Ghi chú</th>
                    <th style="width: 160px; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Không có đơn hàng nào trong hệ thống.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>#@order.Id</strong>
                            </td>
                            <td>
                                <i class="bi bi-clock text-muted me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span><i class="bi bi-person me-1 text-muted"></i> @order.Customer?.FullName</span>
                            </td>
                            <td>
                                @if (order.Status == 0)
                                {
                                    <span class="badge-clean badge-clean-warning"><i class="bi bi-hourglass-split"></i> Chờ duyệt</span>
                                }
                                else if (order.Status == 1)
                                {
                                    <span class="badge-clean badge-clean-primary"><i class="bi bi-truck"></i> Đang giao</span>
                                }
                                else if (order.Status == 2)
                                {
                                    <span class="badge-clean badge-clean-success"><i class="bi bi-check-circle-fill"></i> Đã xong</span>
                                }
                                else
                                {
                                    <span class="badge-clean badge-clean-secondary"><i class="bi bi-x-circle-fill"></i> Đã hủy</span>
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 250px;">
                                @(order.Notes ?? "-")
                            </td>
                            <td>
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="/OrderDetail" class="action-link action-link-detail"><i class="bi bi-search"></i> Chi tiết</a>
                                    <a href="#" class="action-link action-link-delete"><i class="bi bi-trash"></i> Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
