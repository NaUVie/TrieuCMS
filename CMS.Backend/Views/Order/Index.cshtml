@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="flat-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1e293b;">Danh sách đơn hàng</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái giao hàng, quản lý hóa đơn mua sắm và xác nhận đơn của khách hàng</p>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="mb-4">
        <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
            <div class="col-md-5 col-sm-12">
                <label class="form-label fw-bold text-slate small mb-1">Tìm kiếm đơn hàng:</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Nhập mã đơn, tên khách hàng hoặc ghi chú..." value="@ViewBag.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <label class="form-label fw-bold text-slate small mb-1">Trạng thái:</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <option value="0" selected="@(ViewBag.Status == 0)">Đã tiếp nhận</option>
                    <option value="1" selected="@(ViewBag.Status == 1)">Đang đóng gói</option>
                    <option value="2" selected="@(ViewBag.Status == 2)">Đang vận chuyển</option>
                    <option value="3" selected="@(ViewBag.Status == 3)">Đã hoàn thành</option>
                    <option value="4" selected="@(ViewBag.Status == 4)">Đã hủy</option>
                </select>
            </div>

            <div class="col-md-4 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn-clean btn-sm px-3 flex-grow-1" style="height: 31px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;">
                    <i class="bi bi-filter"></i> Lọc đơn
                </button>
                <a href="@Url.Action("Index")" class="btn-clean-outline btn-sm px-2 text-decoration-none text-center" style="height: 31px; display: inline-flex; align-items: center; justify-content: center;" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i> Xóa lọc
                </a>
            </div>
        </form>
    </div>

    <!-- Status Filter Tabs -->
    <div class="d-flex flex-wrap gap-2 mb-3 mt-3">
        <button class="btn btn-sm btn-primary filter-tab active" data-status="all" style="border-radius: 8px;">Tất cả (@(Model?.Count() ?? 0))</button>
        <button class="btn btn-sm btn-outline-secondary filter-tab" data-status="0" style="border-radius: 8px;">Đã tiếp nhận (@(Model?.Count(o => o.Status == 0) ?? 0))</button>
        <button class="btn btn-sm btn-outline-secondary filter-tab" data-status="1" style="border-radius: 8px;">Đang đóng gói (@(Model?.Count(o => o.Status == 1) ?? 0))</button>
        <button class="btn btn-sm btn-outline-secondary filter-tab" data-status="2" style="border-radius: 8px;">Đang vận chuyển (@(Model?.Count(o => o.Status == 2) ?? 0))</button>
        <button class="btn btn-sm btn-outline-secondary filter-tab" data-status="3" style="border-radius: 8px;">Đã hoàn thành (@(Model?.Count(o => o.Status == 3) ?? 0))</button>
        <button class="btn btn-sm btn-outline-secondary filter-tab" data-status="4" style="border-radius: 8px;">Đã hủy (@(Model?.Count(o => o.Status != 0 && o.Status != 1 && o.Status != 2 && o.Status != 3) ?? 0))</button>
    </div>

    <div class="clean-table-container">
        <table class="clean-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Ngày đặt hàng</th>
                    <th>Khách hàng</th>
                    <th>Sản phẩm</th>
                    <th>Trạng thái giao nhận</th>
                    <th>Ghi chú</th>
                    <th style="width: 160px; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không có đơn hàng nào trong hệ thống.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr class="order-row" data-status-group="@(order.Status >= 0 && order.Status <= 3 ? order.Status : 4)">
                            <td>
                                <strong>#@order.Id</strong>
                            </td>
                            <td>
                                <i class="bi bi-clock text-muted me-1"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span><i class="bi bi-person me-1 text-muted"></i> @order.Customer?.FullName</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    @if (order.OrderDetails != null)
                                    {
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            @if (detail.Product != null)
                                            {
                                                <div class="d-flex align-items-center position-relative me-2" title="@detail.Product.Name (x@detail.Quantity)">
                                                    @if (!string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                    {
                                                        <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 32px; height: 32px; object-fit: contain; border-radius: 4px; border: 1px solid #e2e8f0; background: #fff;" onerror="this.src='https://images.unsplash.com/photo-1588449668338-d1345b11a4f1?w=800&auto=format&fit=crop'">
                                                    }
                                                    else
                                                    {
                                                        <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: #f8fafc; border-radius: 4px; border: 1px solid #e2e8f0; color: #94a3b8; font-size: 0.75rem;">
                                                            <i class="bi bi-box-seam"></i>
                                                        </div>
                                                    }
                                                    <span class="badge bg-secondary text-white position-absolute" style="font-size: 0.6rem; top: -6px; right: -8px; padding: 2px 4px; border-radius: 8px;">@detail.Quantity</span>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @if (order.Status == 0)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-receipt"></i> Đã tiếp nhận</span>
                                }
                                else if (order.Status == 1)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-box-seam"></i> Đang đóng gói</span>
                                }
                                else if (order.Status == 2)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-truck"></i> Đang vận chuyển</span>
                                }
                                else if (order.Status == 3)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill"></i> Đã hủy</span>
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 250px;">
                                @(order.Notes ?? "-")
                            </td>
                            <td>
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="action-link action-link-detail"><i class="bi bi-search"></i> Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@order.Id" class="action-link action-link-edit"><i class="bi bi-pencil-square"></i> Duyệt</a>
                                    <a asp-action="Delete" asp-route-id="@order.Id" class="action-link action-link-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?')"><i class="bi bi-trash"></i> Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.filter-tab').click(function () {
                // Toggle active button style
                $('.filter-tab').removeClass('btn-primary active').addClass('btn-outline-secondary');
                $(this).addClass('btn-primary active').removeClass('btn-outline-secondary');

                var status = $(this).data('status');
                
                // Hide temporary empty row if exists
                $('#empty-filter-row').remove();

                if (status === 'all') {
                    $('.order-row').show();
                } else {
                    $('.order-row').hide();
                    var visibleRows = $('.order-row[data-status-group="' + status + '"]');
                    visibleRows.show();

                    // If no rows are visible, append an empty state row
                    if (visibleRows.length === 0) {
                        $('.clean-table tbody').append(
                            '<tr id="empty-filter-row"><td colspan="7" class="text-center py-4 text-muted">Không có đơn hàng nào thuộc trạng thái này.</td></tr>'
                        );
                    }
                }
            });
        });
    </script>
}
