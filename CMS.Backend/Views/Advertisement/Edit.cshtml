@model CMS.Data.Entities.Advertisement

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa Banner/Quảng cáo";
}

<div class="flat-card" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1e293b;"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Banner Quảng Cáo</h4>
        <p class="text-muted small mb-0">Cập nhật thông tin hình ảnh, tiêu đề, và liên kết cho slide quảng cáo trang chủ.</p>
    </div>
    <hr style="border-color: var(--border-light);" />

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-4">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Tiêu đề chính của Banner *</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Dòng mô tả phụ (SubTitle)</label>
            <input asp-for="SubTitle" class="form-control" />
            <span asp-validation-for="SubTitle" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Đường dẫn liên kết (Link URL)</label>
            <input asp-for="LinkUrl" class="form-control" />
            <span asp-validation-for="LinkUrl" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate d-block" style="font-size: 0.9rem;">Ảnh hiện tại:</label>
            <img src="@Model.ImageUrl" style="max-width: 100%; max-height: 150px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 10px;" alt="Banner Current" />
            
            <label class="form-label fw-bold text-slate d-block" style="font-size: 0.9rem;">Tải lên ảnh mới:</label>
            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
            <small class="text-muted d-block mt-1">Để trống nếu muốn giữ nguyên ảnh hiện tại.</small>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Trạng thái hiển thị</label>
            <select asp-for="Status" class="form-select">
                <option value="1">Hiển thị (Active)</option>
                <option value="0">Ẩn (Inactive)</option>
            </select>
        </div>

        <div class="d-flex gap-2 pt-3 border-top" style="border-color: #f1f5f9 !important;">
            <button type="submit" class="btn-clean btn-sm px-4" style="background: #eab308; border-color: #eab308;">
                <i class="bi bi-check-circle"></i> Cập nhật banner
            </button>
            <a asp-action="Index" class="btn-clean-outline btn-sm text-decoration-none px-3">
                Quay lại
            </a>
        </div>
    </form>
</div>
