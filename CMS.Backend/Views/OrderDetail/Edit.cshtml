@model CMS.Data.Entities.OrderDetail

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa Chi tiết Đơn hàng";
}

<div class="flat-card" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1e293b;"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Chi Tiết Đơn Hàng #@Model.OrderId</h4>
        <p class="text-muted small mb-0">Thay đổi mặt hàng hoặc số lượng của linh kiện được đặt mua trong đơn.</p>
    </div>
    <hr style="border-color: var(--border-light);" />

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="OrderId" />

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Chọn sản phẩm</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductList" required></select>
            <span asp-validation-for="ProductId" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Số lượng mua *</label>
            <input asp-for="Quantity" type="number" class="form-control" min="1" required />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 pt-3 border-top" style="border-color: #f1f5f9 !important;">
            <button type="submit" class="btn-clean btn-sm px-4" style="background: #eab308; border-color: #eab308;">
                <i class="bi bi-check-circle"></i> Cập nhật chi tiết
            </button>
            <a asp-action="Index" class="btn-clean-outline btn-sm text-decoration-none px-3">
                Quay lại
            </a>
        </div>
    </form>
</div>
