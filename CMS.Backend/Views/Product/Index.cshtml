@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">QUẢN LÝ SẢN PHẨM</h2>
        <button class="btn btn-success btn-sm">+ Thêm sản phẩm mới</button>
    </div>

    <div class="row">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12 text-center text-muted">Không có sản phẩm nào.</div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <div class="text-center bg-light py-3">
                                <span class="fs-1">📦</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-dark fw-bold mb-0">@item.Name</h5>
                                <span class="badge bg-secondary">@item.CategoryProduct?.Name</span>
                            </div>
                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                            <div class="mt-3 border-top pt-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-danger fw-bold fs-5">@item.Price.ToString("N0") VNĐ</span>
                                    <span class="text-muted small">Kho: @item.StockQuantity</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
