<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrieuCMS Admin</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Clean & Simple CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-cpu-fill fs-4 text-primary"></i>
                <span class="sidebar-logo">TrieuCMS</span>
            </div>
            
            <div class="sidebar-menu">
                <!-- Group 1: Core System -->
                <div class="menu-header">Hệ thống chung</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Bảng điều khiển</span>
                </a>
                
                <!-- Group 2: CMS Subsystem -->
                <div class="menu-header">Quản trị nội dung</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")" 
                   asp-controller="Category" asp-action="Index">
                    <i class="bi bi-tags"></i>
                    <span>Danh mục tin</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Post" ? "active" : "")" 
                   asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-post"></i>
                    <span>Bài viết</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Advertisement" ? "active" : "")" 
                   asp-controller="Advertisement" asp-action="Index">
                    <i class="bi bi-images"></i>
                    <span>Quản lý Banners</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")" 
                   asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Hệ thống User</span>
                </a>
                
                <!-- Group 3: Shop Subsystem -->
                <div class="menu-header">Quản lý bán hàng</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryProduct" ? "active" : "")" 
                   asp-controller="CategoryProduct" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>DM Sản phẩm</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")" 
                   asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")" 
                   asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    <span>Khách hàng</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")" 
                   asp-controller="Order" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Đơn hàng</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderDetail" ? "active" : "")" 
                   asp-controller="OrderDetail" asp-action="Index">
                    <i class="bi bi-card-list"></i>
                    <span>Chi tiết đơn</span>
                </a>
            </div>
            
            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-patch-check-fill text-success"></i>
                    <span>Phiên bản v2.0</span>
                </div>
            </div>
        </aside>

        <!-- Main Viewport Section -->
        <main class="main-content">
            <!-- Header Top Navbar -->
            <header class="top-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-link text-dark d-lg-none p-0" type="button" id="sidebar-toggle">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <div class="h6 mb-0 text-slate d-none d-md-block" style="color: #475569; font-weight: 500;">
                        <span class="text-muted">Hệ thống quản trị / </span>
                        <span class="text-dark fw-bold">@ViewData["Title"]</span>
                    </div>
                </div>
                
                <!-- Admin Profile Badge -->
                <div class="admin-profile">
                    <div class="text-end d-none d-sm-block">
                        <span class="admin-name" style="color: #1e293b;">La Quang Triều</span>
                        <span class="admin-role">MSSV: 2123110160</span>
                    </div>
                    <div class="admin-avatar">
                        LQT
                    </div>
                </div>
            </header>

            <!-- Render Body -->
            <div class="viewport">
                @RenderBody()
            </div>

            <!-- Flat Footer -->
            <footer class="flat-footer text-center">
                <div class="container">
                    <p class="mb-0 text-muted">
                        © 2026 TrieuCMS | Thiết kế bởi <span class="text-dark fw-bold">La Quang Triều - 2123110160</span> | Trường Cao đẳng Công Thương TP.HCM
                    </p>
                </div>
            </footer>
        </main>
    </div>

    <!-- JQuery and Bootstrap Script Assets -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Sidebar toggle for mobile devices -->
    <script>
        $(document).ready(function() {
            $("#sidebar-toggle").click(function(e) {
                e.stopPropagation();
                $(".sidebar").toggleClass("show");
            });
            $(document).click(function(e) {
                if (!$(e.target).closest('.sidebar').length) {
                    $(".sidebar").removeClass("show");
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
