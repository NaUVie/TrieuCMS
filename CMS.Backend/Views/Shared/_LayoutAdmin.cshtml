<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrieuCMS Admin</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Clean & Simple CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-cpu-fill fs-4 text-primary"></i>
                <span class="sidebar-logo">TrieuCMS Admin</span>
            </div>
            
            <div class="sidebar-menu">
                <!-- Group 1: Core System -->
                <div class="menu-header">Hệ thống chung</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Bảng điều khiển</span>
                </a>
                
                <!-- Group 2: CMS Subsystem -->
                <div class="menu-header">Quản trị nội dung</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")" 
                   asp-controller="Category" asp-action="Index">
                    <i class="bi bi-tags"></i>
                    <span>Quản lý Danh mục</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Post" ? "active" : "")" 
                   asp-controller="Post" asp-action="Index">
                    <i class="bi bi-file-earmark-post"></i>
                    <span>Quản lý Bài viết</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Advertisement" ? "active" : "")" 
                   asp-controller="Advertisement" asp-action="Index">
                    <i class="bi bi-images"></i>
                    <span>Quản lý Banners</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")" 
                   asp-controller="User" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Quản lý Thành viên</span>
                </a>
                
                <!-- Group 3: Shop Subsystem -->
                <div class="menu-header">Quản lý bán hàng</div>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryProduct" ? "active" : "")" 
                   asp-controller="CategoryProduct" asp-action="Index">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Danh mục sản phẩm</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")" 
                   asp-controller="Product" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active" : "")" 
                   asp-controller="Customer" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    <span>Khách hàng</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")" 
                   asp-controller="Order" asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Đơn hàng</span>
                </a>
                <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderDetail" ? "active" : "")" 
                   asp-controller="OrderDetail" asp-action="Index">
                    <i class="bi bi-card-list"></i>
                    <span>Đơn hàng chi tiết</span>
                </a>
            </div>
            
            <div class="sidebar-footer">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-patch-check-fill text-success"></i>
                    <span>Phiên bản v2.0</span>
                </div>
            </div>
        </aside>

        <!-- Main Viewport Section -->
        <main class="main-content">
            <!-- Header Top Navbar -->
            <header class="top-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-link text-dark d-lg-none p-0" type="button" id="sidebar-toggle">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <div class="h6 mb-0 text-slate d-none d-md-block" style="color: #475569; font-weight: 500;">
                        <span class="text-muted">Phân hệ Admin / </span>
                        <span class="text-dark fw-bold">@ViewData["Title"]</span>
                    </div>
                </div>
                
                <!-- Admin Profile Badge -->
                <div class="admin-profile d-flex align-items-center gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="text-end d-none d-sm-block">
                            <span class="admin-name" style="color: #1e293b;">@User.FindFirst("FullName")?.Value</span>
                            <span class="admin-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </div>
                        <div class="admin-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm ms-2">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </a>
                    }
                    else
                    {
                        <div class="text-end d-none d-sm-block">
                            <span class="admin-name" style="color: #1e293b;">Khách</span>
                            <span class="admin-role">Chưa đăng nhập</span>
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm ms-2">
                            Đăng nhập
                        </a>
                    }
                </div>
            </header>

            <!-- Render Body -->
            <div class="viewport text-start">
                @RenderBody()
            </div>

            <!-- Flat Footer -->
            <footer class="flat-footer text-center mt-auto">
                <div class="container">
                    <p class="mb-0 text-muted">
                        © 2026 TrieuCMS | Thiết kế bởi <span class="text-dark fw-bold">La Quang Triều - 2123110160</span> | Trường Cao đẳng Công Thương TP.HCM
                    </p>
                </div>
            </footer>
        </main>
    </div>

    <!-- JQuery and Bootstrap Script Assets -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Sidebar toggle & SweetAlert2 Confirmations -->
    <script>
        $(document).ready(function() {
            // Sidebar toggle for mobile devices
            $("#sidebar-toggle").click(function(e) {
                e.stopPropagation();
                $(".sidebar").toggleClass("show");
            });
            $(document).click(function(e) {
                if (!$(e.target).closest('.sidebar').length) {
                    $(".sidebar").removeClass("show");
                }
            });

            // Intercept all confirm calls on links and buttons
            $('a[onclick*="confirm"], button[onclick*="confirm"], input[onclick*="confirm"]').each(function() {
                var $el = $(this);
                var onclickAttr = $el.attr('onclick');
                
                var match = onclickAttr.match(/confirm\(['"](.*?)['"]\)/);
                if (match && match[1]) {
                    var message = match[1];
                    $el.removeAttr('onclick');
                    
                    $el.on('click', function(e) {
                        e.preventDefault();
                        var href = $el.attr('href');
                        var form = $el.closest('form');
                        
                        Swal.fire({
                            title: 'Xác nhận hành động',
                            text: message,
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#ef4444',
                            cancelButtonColor: '#6b7280',
                            confirmButtonText: 'Đồng ý',
                            cancelButtonText: 'Hủy bỏ',
                            background: '#ffffff',
                            color: '#1e293b'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                if (href) {
                                    window.location.href = href;
                                } else if (form.length > 0) {
                                    form.submit();
                                }
                            }
                        });
                    });
                }
            });

            // Handle TempData notifications with SweetAlert2
            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '@Html.Raw(TempData["Success"])',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: '@Html.Raw(TempData["Error"])',
                    confirmButtonColor: '#ef4444'
                });
                </text>
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
