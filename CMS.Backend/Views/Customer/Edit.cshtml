@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa thông tin Khách hàng";
}

<div class="flat-card" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1e293b;"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh Sửa Khách Hàng</h4>
        <p class="text-muted small mb-0">Cập nhật hồ sơ thông tin liên hệ và đặt lại mật khẩu cho khách hàng.</p>
    </div>
    <hr style="border-color: var(--border-light);" />

    <form asp-action="Edit" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" />

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Email tài khoản:</label>
            <input class="form-control" value="@Model.Email" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Họ và tên *</label>
            <input asp-for="FullName" class="form-control" required />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Số điện thoại</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Địa chỉ liên hệ</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Mật khẩu mới (Để trống nếu giữ nguyên)</label>
            <input type="password" name="NewPassword" class="form-control" />
        </div>

        <div class="d-flex gap-2 pt-3 border-top" style="border-color: #f1f5f9 !important;">
            <button type="submit" class="btn-clean btn-sm px-4" style="background: #eab308; border-color: #eab308;">
                <i class="bi bi-check-circle"></i> Cập nhật thông tin
            </button>
            <a asp-action="Index" class="btn-clean-outline btn-sm text-decoration-none px-3">
                Quay lại
            </a>
        </div>
    </form>
</div>
