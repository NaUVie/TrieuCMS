@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm mới Khách hàng";
}

<div class="flat-card" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #1e293b;"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Thêm Mới Khách Hàng</h4>
        <p class="text-muted small mb-0">Tạo tài khoản khách hàng mới để mua sắm trên hệ thống.</p>
    </div>
    <hr style="border-color: var(--border-light);" />

    <form asp-action="Create" method="post" class="mt-4">
        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Họ và tên *</label>
            <input asp-for="FullName" class="form-control" required />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Email đăng nhập *</label>
            <input asp-for="Email" type="email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Mật khẩu *</label>
            <input asp-for="Password" type="password" class="form-control" required />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Số điện thoại</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-slate" style="font-size: 0.9rem;">Địa chỉ liên hệ</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 pt-3 border-top" style="border-color: #f1f5f9 !important;">
            <button type="submit" class="btn-clean btn-sm px-4">
                <i class="bi bi-check-circle"></i> Thêm khách hàng
            </button>
            <a asp-action="Index" class="btn-clean-outline btn-sm text-decoration-none px-3">
                Quay lại
            </a>
        </div>
    </form>
</div>
